{
  "name": "openvsmobile-next-backend",
  "version": "0.4.7",
  "private": true,
  "description": "openvsmobile backend — workspaces, terminal, fs, git, notifications, plugin host (forthcoming).",
  "type": "module",
  "engines": {
    "node": ">=25"
  },
  "scripts": {
    "postinstall": "node scripts/fix-node-pty-spawn-helper.mjs",
    "typecheck": "pnpm --filter \"./packages/*\" run typecheck && tsc --noEmit",
    "build": "pnpm --filter \"./packages/*\" run build && tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "pnpm --filter \"./packages/*\" run build && vitest run"
  },
  "dependencies": {
    "@homebridge/ciao": "^1.3.1",
    "@number0/iroh": "1.0.0",
    "@openvsmobile/sdk": "workspace:*",
    "better-sqlite3": "^12.10.0",
    "chokidar": "^4.0.3",
    "ignore": "^7.0.3",
    "node-pty": "^1.0.0",
    "qrcode-terminal": "^0.12.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20.14.0",
    "@types/ws": "^8.5.12",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "vitest": "^4.1.6"
  }
}
