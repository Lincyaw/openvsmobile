FROM node:22-slim

WORKDIR /app

# Copy compiled OpenVSCode Server
COPY openvscode-server/package.json openvscode-server/package-lock.json ./
COPY openvscode-server/node_modules ./node_modules
COPY openvscode-server/out ./out
COPY openvscode-server/extensions ./extensions
COPY openvscode-server/product.json .
COPY openvscode-server/resources ./resources
COPY openvscode-server/ThirdPartyNotices.txt .
COPY openvscode-server/README.md .
COPY openvscode-server/LICENSE.txt .
COPY openvscode-server/.nvmrc .

# NLS messages file is optional but suppresses a warning
RUN echo '{}' > out/nls.messages.json

EXPOSE 3003

CMD ["node", "out/server-main.js", "--port", "3003", "--host", "0.0.0.0", "--connection-token", "test", "--accept-server-license-terms"]
